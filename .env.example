# Node reads this with: node --env-file=.env server/index.mjs
HOST=127.0.0.1
PORT=4317
RELAY_DB_PATH=data/relay.sqlite
RELAY_AGENT_MODE=scripted
# Required when HOST is not loopback. Never embed this token in browser assets.
# RELAY_API_TOKEN=replace-with-a-long-random-secret
# RELAY_PUBLIC_ORIGIN=https://your-private-server.example
# Allow only your exact frontend origin for an external Node connection.
# RELAY_ALLOWED_ORIGINS=https://relay-household-rescue.mistylamp32.chatgpt.site
# AWS_PROFILE=your-existing-profile
# Optional real model host. Requires your own AWS credentials and model access.
# RELAY_AGENT_MODE=bedrock
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=your-enabled-converse-model-or-inference-profile-id
